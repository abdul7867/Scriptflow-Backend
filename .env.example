# ============================================
# SCRIPTFLOW BACKEND CONFIGURATION
# ============================================
# SECURITY NOTES:
# - Never commit .env files to version control
# - Use strong, randomly generated keys in production
# - ADMIN_API_KEY is REQUIRED in production (NODE_ENV=production)
# ============================================

# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection String
# Get this from: https://cloud.mongodb.com/ (Free Tier)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# SECURITY: Use a dedicated database user with limited permissions
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/scriptflow?retryWrites=true&w=majority

# Redis Connection String
# Get this from: https://upstash.com/ (Free Tier)
# Format: rediss://:<password>@<host>:<port>
# SECURITY: Use TLS connection (rediss://) in production
REDIS_URL=rediss://default:your_password@your-endpoint.upstash.io:6379

# Queue Configuration
QUEUE_CONCURRENCY=5

# Rate Limiting
# IP-based: requests per 15 minutes
RATE_LIMIT_MAX=100
# User-based: requests per hour per subscriber_id
USER_RATE_LIMIT=10
# Max active beta users (others on waitlist)
MAX_BETA_USERS=100

# Google Vertex AI (replaces Gemini API Key)
# Get service account from: https://console.cloud.google.com/
# REQUIRED: GCP_PROJECT_ID and service account JSON
# SECURITY: Never commit gcp-service-account.json to version control
# Place your service account file at: secrets/gcp-service-account.json
GCP_PROJECT_ID=abdul-content-creation
GCP_LOCATION=us-central1
# Local dev: ./secrets/gcp-service-account.json
# Docker: /app/secrets/gcp-service-account.json (auto-mounted)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json

# ManyChat API Key
# Get this from: ManyChat Settings > API
MANYCHAT_API_KEY=your_manychat_api_key

# ============================================
# MANYCHAT PULL-BASED DELIVERY
# ============================================
# These fields enable "pull-based" delivery to avoid Meta's 24-hour window restrictions.
# Instead of pushing messages directly (which causes 400 errors), we update custom fields.
# ManyChat automation reads these fields and displays content to the user.
#
# SINGLE SOURCE OF TRUTH: sc_status
# ALLOWED STATES (Backend writes these): IDLE, AWAITING_IDEA, PROCESSING, READY, ERROR, BUSY
# ManyChat may ONLY write: sc_status = DELIVERED (after delivering script)
#
# SETUP:
# 1. Create these Text-type custom fields in ManyChat:
#    - sc_status (stores IDLE/AWAITING_IDEA/PROCESSING/READY/DELIVERED/ERROR/BUSY)
#    - sc_last_script (script text content)
#    - sc_last_image (URL to script image)
#    - sc_reel_url (current reel being processed)
#    - sc_prompt_message (contextual message for user)
#    - sc_copy_url (URL for copying script)
#    - sc_error_code (error code for debugging, optional)
# 2. Copy the field IDs from ManyChat (Settings > Custom Fields > click field > see ID in URL)
# 3. Paste the IDs below
#
# CRITICAL: Backend NEVER sends Instagram messages! Only updates custom fields.
MANYCHAT_SC_STATUS_FIELD_ID=       # Status: IDLE/AWAITING_IDEA/PROCESSING/READY/DELIVERED/ERROR/BUSY
MANYCHAT_SC_LAST_SCRIPT_FIELD_ID=  # Script text content
MANYCHAT_SC_LAST_IMAGE_FIELD_ID=   # ImgBB URL to script image
MANYCHAT_SC_REEL_URL_FIELD_ID=     # Current reel being processed
MANYCHAT_SC_PROMPT_MESSAGE_FIELD_ID= # Contextual message to display
MANYCHAT_SC_COPY_URL_FIELD_ID=     # URL for copying script text
MANYCHAT_SC_ERROR_CODE_FIELD_ID=   # Error code for debugging (optional)

# ImgBB API Key (for image hosting)
# Get this from: https://api.imgbb.com/
IMGBB_API_KEY=your_imgbb_api_key



# ============================================
# SECURITY: REQUIRED IN PRODUCTION
# ============================================
# Admin API Key (for protected endpoints like /api/v1/dataset/export)
# REQUIRED when NODE_ENV=production
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# ============================================
# AWS CONFIGURATION (For S3 & Deployment)
# ============================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
IMAGE_PROVIDER=imgbb # switch to 's3' when ready

# Analysis Mode: audio | frames | hybrid
ANALYSIS_MODE=hybrid

# ============================================
# PUBLIC URLS
# ============================================
# Base URL for public script links (used for copy-friendly URLs)
# In production, set this to your Render/Railway/etc URL
# Example: https://scriptflow-backend.onrender.com
BASE_URL=

# ============================================
# INSTAGRAM AUTHENTICATION (Optional)
# ============================================
# Path to Instagram cookies file for authenticated downloads
# Export cookies from browser using "Get cookies.txt LOCALLY" extension
# SECURITY: Never commit cookies file to version control
# Place your cookies file at: secrets/instagram_cookies.txt
# Local dev: ./secrets/instagram_cookies.txt
# Docker: /app/secrets/instagram_cookies.txt (auto-mounted)
INSTAGRAM_COOKIES_PATH=./secrets/instagram_cookies.txt
