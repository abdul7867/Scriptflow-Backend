# Build Stage
FROM node:20-slim AS builder

WORKDIR /app

# Install build dependencies (python-is-python3 creates symlink from python -> python3)
RUN apt-get update && apt-get install -y \
    python3 \
    python-is-python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
RUN npm run build

# Production Stage
FROM node:20-slim

WORKDIR /app

# Install runtime dependencies (FFmpeg + Python3 for yt-dlp)
RUN apt-get update && apt-get install -y \
    python3 \
    python-is-python3 \
    ffmpeg \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install yt-dlp (required for Instagram video downloads)
RUN curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
    && chmod a+rx /usr/local/bin/yt-dlp

# Use the built-in 'node' user (UID/GID 1000) from node:20-slim
# This matches the default ubuntu user on EC2, ensuring mounted volumes are writable

# Copy built artifacts and production deps
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package*.json ./

# Install production dependencies only (npm 7+ syntax)
RUN npm ci --omit=dev



# Create temp directory with cache/config subdirectories for yt-dlp
RUN mkdir -p temp/.cache temp/.config \
    && chown -R node:node /app

# Create secrets directory for sensitive files (mounted at runtime)
# Contains: gcp-service-account.json, instagram_cookies.txt, etc.
RUN mkdir -p secrets \
    && touch secrets/gcp-service-account.json secrets/instagram_cookies.txt \
    && chown -R node:node /app/secrets

# Environment Setup
ENV NODE_ENV=production
ENV PORT=3000
# Memory configuration for t3.micro (1GB RAM)
# Heap limit: 640MB, leaving room for OS + FFmpeg + yt-dlp
ENV NODE_OPTIONS="--max-old-space-size=600 --expose-gc"
ENV MEMORY_HEAP_LIMIT_MB=600
# Redirect yt-dlp to use writable temp directory (prevents read-only filesystem errors)
ENV HOME=/app/temp
ENV XDG_CACHE_HOME=/app/temp/.cache
ENV XDG_CONFIG_HOME=/app/temp/.config
# GCP credentials path (mounted at runtime from ./secrets volume)
ENV GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-service-account.json

# Switch to non-root user (node user has UID/GID 1000)
USER node

# Expose port
EXPOSE 3000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

# Start application
CMD ["node", "dist/index.js"]
