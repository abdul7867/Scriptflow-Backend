# ==============================================
# SCRIPTFLOW BACKEND - .dockerignore
# Reduces Docker image size and improves security
# Updated: 2026-01-08
# ==============================================

# ==============================================
# VERSION CONTROL
# ==============================================
.git
.gitignore
.gitattributes
.github/

# ==============================================
# ENVIRONMENT & SECRETS
# CRITICAL: Do NOT copy these into Docker image - mount at runtime!
# ==============================================
.env
.env.*
.env.local
.env.development
.env.production
!.env.example

# GCP Service Account (mount at runtime, don't bake into image)
gcp-service-account.json
*-service-account*.json
abdul-content-creation-*.json
service-account*.json

# Secrets folder (mount at runtime)
secrets/
!secrets/.gitkeep

# Instagram Cookies (mount at runtime)
instagram_cookies.txt
*_cookies.txt
cookies.txt

# AWS Credentials
.aws/
credentials

# ==============================================
# DEPENDENCIES (installed fresh in Docker)
# ==============================================
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
yarn.lock
pnpm-lock.yaml

# ==============================================
# BUILD ARTIFACTS (rebuilt in Docker)
# ==============================================
dist/
build/
*.js.map

# ==============================================
# TEMPORARY & DATA FILES
# ==============================================
temp/
tmp/
data
data/
*.db
*.sqlite
*.sqlite3
scriptflow.db
mongodb_data/
redis_data/
logs/

# Test output
*_output.txt
full_test_output.txt
test_output.txt
logs.txt
*.log
generated_scripts/

# ==============================================
# DOCUMENTATION (not needed in production image)
# ==============================================
*.md
!README.md
docs/
deployment/

# ==============================================
# IDE & EDITOR
# ==============================================
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ==============================================
# TESTING (not needed in production)
# ==============================================
tests/
coverage/
*.test.ts
*.spec.ts
jest.config.js
jest.setup.js
.nyc_output/
__tests__/
__mocks__/

# ==============================================
# DEVELOPMENT SCRIPTS (not needed in production)
# ==============================================
scripts/
src/test-*.ts
scratch/
debug/

# ==============================================
# OS FILES
# ==============================================
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
ehthumbs.db

# ==============================================
# DOCKER FILES (prevent recursive copy)
# ==============================================
Dockerfile
Dockerfile.*
Dockerfile.aws
docker-compose*.yml
.dockerignore

# ==============================================
# DEPLOYMENT CONFIG (not needed inside container)
# ==============================================
render.yaml
deploy-aws.md
ecosystem.config.js
*.sh
!entrypoint.sh

# ==============================================
# MEDIA FILES (generated at runtime)
# ==============================================
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.webm
*.mp3
*.wav

# ==============================================
# POSTMAN (not needed in production)
# ==============================================
postman/
